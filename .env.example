# Supabase — required. Sign-in and your library both live here.
# Create a project at https://supabase.com, then run the schema SQL that
# Settings -> Cloud storage -> "Copy schema SQL" gives you.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# RAWG — optional. Without a key, catalog search returns nothing and games
# have to be entered by hand. Free key: https://rawg.io/apidocs
VITE_RAWG_API_KEY=""

# Live Steam and PlayStation data needs no variable here.
#
# Vite inlines every VITE_* value into the shipped bundle, so a Steam Web API
# key placed in this file would be public. It belongs to the edge function
# instead:
#
#   supabase secrets set STEAM_API_KEY=<key>
#   supabase functions deploy game-data
#
# The function is reached at VITE_SUPABASE_URL/functions/v1/game-data, so the
# two variables above are all the client needs. The PlayStation NPSSO is not
# configuration at all — it is entered in Settings and exchanged server-side.
