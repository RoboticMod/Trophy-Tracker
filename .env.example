# Supabase — required. Sign-in and your library both live here.
# Create a project at https://supabase.com, then run the schema SQL that
# Settings -> Cloud storage -> "Copy schema SQL" gives you.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# RAWG — optional. Without a key, catalog search returns nothing and games
# have to be entered by hand. Free key: https://rawg.io/apidocs
VITE_RAWG_API_KEY=""
