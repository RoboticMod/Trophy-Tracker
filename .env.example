# Supabase — required. Sign-in and your library both live here.
# Create a project at https://supabase.com, then run the schema SQL that
# Settings -> Cloud storage -> "Copy schema SQL" gives you.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# RAWG — optional. Without a key, catalog search falls back to a small
# built-in list. Free key: https://rawg.io/apidocs
VITE_RAWG_API_KEY=""
